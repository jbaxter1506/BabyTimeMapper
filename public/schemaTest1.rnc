start = root 
root = element xml { type+ }
type = element idk  {num, date, other}

num = attribute num { xsd:integer}
date = element date {when, empty}
#the empty element is used for the attrubute it means that it can not hold anything but the attribute 
other = element other {type?, text}
when = attribute  when {xsd:date | xsd:gYearMonth}
cap = attribute type { "caps"  |  "nocaps" }


